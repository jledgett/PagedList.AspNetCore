<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>10.0.11</Version>
    <Description>A tag helper for generating pager controls, compatible with ASP.NET Core 10+. Includes the PagedList paging types (IPagedList, StaticPagedList, PagedList) so no additional package is required.</Description>
    <Authors>Jeffrey L. Edgett, Troy Goode, Hieu Le</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Jeffrey L. Edgett</Copyright>
    <PackageProjectUrl>https://github.com/jledgett/PagedList.AspNetCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jledgett/PagedList.AspNetCore</RepositoryUrl>
    <PackageTags>paging pagination pagedlist asp.net core mvc taghelper</PackageTags>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
